<template>
  <view :style="containerStyle">
    <text :style="titleStyle">🎨 Vuvas SFC Demo</text>
    <text :style="subtStyle">这是一个 .vuvas 单文件组件</text>

    <view :style="cardStyle">
      <text :style="labelStyle">计数器: {{ count }}</text>
      <view :style="btnRow">
        <view :style="btnStyle" @click="increment">
          <text :style="btnTextStyle">+1</text>
        </view>
        <view :style="btnDangerStyle" @click="decrement">
          <text :style="btnTextStyle">-1</text>
        </view>
        <view :style="btnSecondaryStyle" @click="reset">
          <text :style="btnTextStyle">重置</text>
        </view>
      </view>
    </view>

    <view :style="cardStyle">
      <text :style="labelStyle">状态: {{ status }}</text>
      <text :style="hintStyle">↑ 点击按钮改变计数，状态会自动更新</text>
    </view>

    <view v-if="count > 5" :style="alertStyle">
      <text :style="alertTextStyle">⚠️ 计数已超过 5！</text>
    </view>

    <view :style="listCard">
      <text :style="labelStyle">待办列表:</text>
      <view v-for="item in todos" :key="item.id" :style="todoItemStyle">
        <text :style="todoTextStyle">{{ item.done ? '✅' : '⬜' }} {{ item.text }}</text>
      </view>
    </view>
  </view>
</template>

<script setup>
import { ref, computed } from 'vuvas'

const count = ref(0)

const status = computed(() => {
  if (count.value === 0) return '😐 初始状态'
  if (count.value > 0) return '😊 正数'
  return '😢 负数'
})

const todos = ref([
  { id: 1, text: '学习 Vuvas', done: true },
  { id: 2, text: '编写 .vuvas 组件', done: true },
  { id: 3, text: '发布 1.0 版本', done: false }
])

function increment() {
  count.value++
}

function decrement() {
  count.value--
}

function reset() {
  count.value = 0
}
</script>

