  padding: 20;
  background: #ffffff;
  border-radius: 12;
  gap: 12;
  shadow-color: rgba(0,0,0,0.08);
  shadow-blur: 12;
}

.labelStyle {
  font-size: 18;
  font-weight: bold;
  color: #333333;
}

.hintStyle {
  font-size: 12;
  color: #999999;
}

.btnRow {
  flex-direction: row;
  gap: 10;
}

.btnStyle {
  padding: 8 16;
  background: #42b883;
  border-radius: 6;
}

.btnDangerStyle {
  padding: 8 16;
  background: #e74c3c;
  border-radius: 6;
}

.btnSecondaryStyle {
  padding: 8 16;
  background: #95a5a6;
  border-radius: 6;
}

.btnTextStyle {
  font-size: 14;
  font-weight: bold;
  color: #ffffff;
}

.alertStyle {
  padding: 12 16;
  background: #fff3cd;
  border-radius: 8;
  border-color: #ffc107;
  border-width: 1;
}

.alertTextStyle {
  font-size: 14;
  color: #856404;
}

.listCard {
  padding: 20;
  background: #ffffff;
  border-radius: 12;
  gap: 8;
}

.todoItemStyle {
