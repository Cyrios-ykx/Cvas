{
  "name": "vuvas",
  "version": "0.1.0",
  "description": "Canvas 上的 Vue —— 让开发者用类 Vue 的方式开发渲染在 Canvas 上的 UI",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./router": {
      "import": {
        "types": "./dist/types/router/index.d.ts",
        "default": "./dist/router.mjs"
      },
      "require": {
        "types": "./dist/types/router/index.d.ts",
        "default": "./dist/router.cjs"
      }
    },
    "./store": {
      "import": {
        "types": "./dist/types/store/index.d.ts",
        "default": "./dist/store.mjs"
      },
      "require": {
        "types": "./dist/types/store/index.d.ts",
        "default": "./dist/store.cjs"
      }
    },
    "./compiler": {
      "import": {
        "types": "./dist/types/compiler/index.d.ts",
        "default": "./dist/compiler.mjs"
      },
      "require": {
        "types": "./dist/types/compiler/index.d.ts",
        "default": "./dist/compiler.cjs"
      }
    },
    "./animation": {
      "import": {
        "types": "./dist/types/animation/index.d.ts",
        "default": "./dist/animation.mjs"
      },
      "require": {
        "types": "./dist/types/animation/index.d.ts",
        "default": "./dist/animation.cjs"
      }
    },
    "./components": {
      "import": {
        "types": "./dist/types/components/index.d.ts",
        "default": "./dist/components.mjs"
      },
      "require": {
        "types": "./dist/types/components/index.d.ts",
        "default": "./dist/components.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:types": "tsc --project tsconfig.build.json",
    "build:all": "npm run build:lib",
    "prepublishOnly": "npm run build:lib",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "canvas",
    "vue",
    "ui",
    "framework",
    "reactive",
    "component",
    "flexbox",
    "typescript",
    "vite"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Cyrios-ykx/vuvas.git"
  },
  "homepage": "https://github.com/Cyrios-ykx/vuvas#readme",
  "bugs": {
    "url": "https://github.com/Cyrios-ykx/vuvas/issues"
  },
  "author": "Cyrios-ykx",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.4"
  }
}
